{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pdf-ocr-cleaner",
  "version": "0.1.0",
  "identifier": "com.wuyax.pdf-ocr-cleaner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PDF OCR Cleaner",
        "width": 900,
        "height": 700,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000 http://localhost:1420 tauri://localhost http://tauri.localhost https://tauri.localhost ws://localhost:1420; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/python-sidecar"
    ],
    "resources": [
      "resources/ocr_models/*"
    ]
  }
}
