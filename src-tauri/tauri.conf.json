{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pdf-ocr-cleaner",
  "version": "0.1.0",
  "identifier": "com.wuyax.pdf-ocr-cleaner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "temp-app",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "tauri": {
    "allowlist": {
      "dialog": {
        "all": true,
        "open": true
      },
      "http": {
        "all": true,
        "request": true,
        "scope": ["http://127.0.0.1:8000/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
